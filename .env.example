# Vitalog – environment variables. Copy to .env for local development.
# NEVER commit real secrets. In production use a secret manager (see docs/07-DEPLOYMENT.md).

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Local Postgres from docker-compose (dev only credentials)
DATABASE_URL=postgres://vitalog:vitalog_dev_only@127.0.0.1:5433/vitalog

# 32 random bytes, base64:  openssl rand -base64 32   (production: KMS-managed)
ENCRYPTION_KEK=
# >= 32 random chars:       openssl rand -base64 48
URL_SIGNING_SECRET=

STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=../../storage/files
# S3-compatible (Scaleway fr-par / OVHcloud / AWS eu-central-1), private bucket
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

OCR_PROVIDER=tesseract          # tesseract | none
# Production: local copy of tessdata_best (bul, eng) so nothing is downloaded at runtime
TESSERACT_LANG_PATH=
TESSERACT_CACHE_DIR=../../storage/tessdata

AI_PROVIDER=none                # none | openai | anthropic | mock (mock: tests only)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1   # or an EU endpoint (Azure OpenAI EU Data Zone, Mistral)
AI_MODEL=gpt-4.1-mini

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30
MONTHLY_PROCESSING_LIMIT=50
MONTHLY_AI_LIMIT=30
REQUIRE_EMAIL_VERIFICATION=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
DEMO_MODE_ENABLED=true
DEMO_TTL_HOURS=24
AUDIT_RETENTION_DAYS=365
EMAIL_PROVIDER=console          # console | smtp
SMTP_URL=
EMAIL_FROM=Vitalog <no-reply@vitalog.example>
TRUST_PROXY=false
LOG_LEVEL=info

# Local seed (synthetic demo account) – development only
SEED_DEMO_EMAIL=demo@vitalog.example
SEED_DEMO_PASSWORD=Vitalog-Demo-2026!
