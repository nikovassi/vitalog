# Set DOMAIN (e.g. app.vitalog.eu). Caddy obtains/renews TLS certificates automatically.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:4000} {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv
		# hashed assets: long cache; HTML: no cache
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@private path /app* /s/* /login /register /reset /verify /forgot
		header @private X-Robots-Tag "noindex, nofollow"
		try_files {path} /index.html
		file_server
	}
}
