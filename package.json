{
  "name": "vitalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "npm run dev -w @vitalog/api & npm run worker -w @vitalog/api & npm run dev -w @vitalog/web",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @vitalog/api",
    "db:seed": "npm run seed -w @vitalog/api",
    "fixtures": "npm run fixtures -w @vitalog/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run e2e -w @vitalog/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run typecheck"
  }
}
